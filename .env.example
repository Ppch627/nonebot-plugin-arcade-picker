# ============ 附近机厅推荐插件（nonebot-plugin-arcade-picker）============

# 必填：机器人对外可达的站点根地址，例如 https://bot.example.com
# 必须是浏览器（尤其是手机 QQ 内置浏览器）能访问的 HTTPS 地址，
# 否则 HTML5 定位会被浏览器禁用，用户只能手动输入坐标。
ARCADE_PUBLIC_BASE_URL=https://bot.example.com

# 搜索半径（公里）
ARCADE_SEARCH_RADIUS_KM=10

# 最多推荐 / 推送多少家机厅
ARCADE_MAX_RESULTS=10

# 默认每枚币价格（元）
ARCADE_DEFAULT_COIN_PRICE=1.0

# 连锁品牌价目表（内联 JSON）：机厅名包含关键字即命中
# ARCADE_CHAIN_COIN_PRICES={"风云再起": 1.0, "城市英雄": 0.75, "汤姆熊": 1.2}

# 团购（美团/抖音）套餐价表：二选一或同时使用（内联优先）
# 文件形式（推荐，用 scripts/build_deal_prices.py 生成）：
# ARCADE_DEAL_COIN_PRICES_FILE=/path/to/deal_coin_prices.json
# 内联形式：
# ARCADE_DEAL_COIN_PRICES={"风云再起上海人民广场店": {"price": 0.5, "source": "美团"},
#                           "城市英雄XX店": {"price": 0.6, "source": "抖音"}}

# 是否从机厅/游戏评论中正则抽取“每币价格 / 折扣”信息（默认开启）
ARCADE_USE_COIN_PRICE_HEURISTICS=true

# 综合评分权重（会自动归一化，相对大小才是关键）
ARCADE_WEIGHT_DISTANCE=0.4
ARCADE_WEIGHT_COUNT=0.3
ARCADE_WEIGHT_PRICE=0.3

# 距离衰减尺度（公里）：距离为该值时距离分=0.5
ARCADE_DISTANCE_SCALE_KM=3.0
# 机台数饱和阈值：达到该数量机台数分=1
ARCADE_COUNT_SATURATE=4
# 单局成本衰减尺度（元）：成本为该值时价格分=0.5
ARCADE_PRICE_SCALE_YUAN=6.0

# 定位链接 token 有效期（秒）
ARCADE_TOKEN_TTL_SECONDS=600
